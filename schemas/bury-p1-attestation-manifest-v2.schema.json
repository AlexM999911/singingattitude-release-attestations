{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlexM999911/singingattitude-release-attestations/schemas/bury-p1-attestation-manifest-v2.schema.json",
  "title": "Closed Bury P1 single-owner manifest schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordId", "trustModel", "repository", "authorization", "candidate", "target", "executionWindow", "migrations", "owner", "boundaries"],
  "properties": {
    "schemaVersion": { "const": "bury-p1-attestation-manifest-v2" },
    "recordId": { "type": "string", "pattern": "^BURY-P1-[A-Z0-9-]{8,120}$" },
    "trustModel": { "const": "BURY-P1-MODE-A-GITHUB-ATTESTATION-SINGLE-OWNER-V2" },
    "repository": { "const": "AlexM999911/singingattitude-release-attestations" },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["authorizationId", "oneUse", "p1Authorized", "g2Authorized", "productionBookingAuthorized"],
      "properties": {
        "authorizationId": { "type": "string", "pattern": "^BURY-P1-[A-Z0-9-]{8,120}$" },
        "oneUse": { "const": true }, "p1Authorized": { "const": true },
        "g2Authorized": { "const": false }, "productionBookingAuthorized": { "const": false }
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "tree", "pathListSha256", "contentLedgerSha256", "completeBundleSha256", "migrationLedgerSha256"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitSha" }, "tree": { "$ref": "#/$defs/gitSha" },
        "pathListSha256": { "$ref": "#/$defs/sha256" }, "contentLedgerSha256": { "$ref": "#/$defs/sha256" },
        "completeBundleSha256": { "$ref": "#/$defs/sha256" }, "migrationLedgerSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "reference", "nonProduction", "noCustomerData", "exclusiveLocalhost"],
      "properties": {
        "profile": { "const": "isolated-localhost-disposable-v1" },
        "reference": { "type": "string", "pattern": "^local-supabase://[a-z0-9-]{8,96}$" },
        "nonProduction": { "const": true }, "noCustomerData": { "const": true }, "exclusiveLocalhost": { "const": true }
      }
    },
    "executionWindow": { "$ref": "#/$defs/window" },
    "migrations": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["order", "path", "sha256"],
        "properties": {
          "order": { "type": "integer", "minimum": 1, "maximum": 16 },
          "path": { "type": "string", "pattern": "^(tests/sql/bury-acuity-authority/(?:00_baseline|10_p1_noncustomer_identity_approval)\\.sql|supabase/migrations/[0-9]{14}_[a-z0-9_]+\\.sql)$" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "owner": { "$ref": "#/$defs/owner" },
    "boundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["production", "providers", "payments", "email", "deployment", "publicBooking", "g2"],
      "properties": {
        "production": { "const": false }, "providers": { "const": false }, "payments": { "const": false },
        "email": { "const": false }, "deployment": { "const": false }, "publicBooking": { "const": false }, "g2": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "canonicalUtc": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$" },
    "window": { "type": "object", "additionalProperties": false, "required": ["startsAtUtc", "expiresAtUtc"], "properties": { "startsAtUtc": { "$ref": "#/$defs/canonicalUtc" }, "expiresAtUtc": { "$ref": "#/$defs/canonicalUtc" } } },
    "owner": { "type": "object", "additionalProperties": false, "required": ["githubLogin", "githubAccountId", "businessOwner", "technicalOwner"], "properties": { "githubLogin": { "const": "AlexM999911" }, "githubAccountId": { "const": "234956861" }, "businessOwner": { "const": true }, "technicalOwner": { "const": true } } }
  }
}
