{
  "schemaVersion": "bury-p1-public-content-policy-v1",
  "trustModel": "BURY-P1-MODE-A-GITHUB-ATTESTATION-SINGLE-OWNER-V2",
  "repositoryScope": "public-attestation-only",
  "allow": [
    "deterministic release manifests",
    "private source commit and tree identifiers",
    "path-list hashes",
    "content-ledger hashes",
    "complete-bundle hashes",
    "migration, preflight, and read-back filenames, order, and hashes",
    "Alex owner authorization receipts and SHA-256 sidecars",
    "policy and JSON Schema files",
    "credentialless GitHub Actions workflows",
    "GitHub-native attestation bundles",
    "redacted verification receipts",
    "protected one-use consumption receipts"
  ],
  "deny": [
    "private Singing Attitude source code",
    "application source patches",
    "database dumps or customer database contents",
    "customer or student data",
    "raw email addresses",
    "raw Supabase Auth UUIDs",
    "credentials or API tokens",
    "production environment values",
    "Stripe, Supabase, Acuity, Cal.com, Resend, or SendPulse configuration",
    "private keys",
    "custom P-256 or Ed25519 signing material"
  ],
  "controls": {
    "attestationOnly": true,
    "singleOwnerAuthorization": true,
    "ownerAuthorizationSidecarRequired": true,
    "noCustomPrivateSigningKeys": true,
    "noEnvironmentSecrets": true,
    "noRepositorySecrets": true,
    "sourceRepositoriesRemainPrivate": true
  },
  "authority": {
    "repositoryCreationAuthorised": true,
    "workflowImplementationAuthorised": true,
    "trustedPullRequestValidatorImplementationAuthorised": true,
    "p1ExecutionAuthorised": false,
    "g2Authorised": false,
    "databaseStartupOrMigrationAuthorised": false,
    "productionChangeAuthorised": false,
    "providerOperationAuthorised": false,
    "bookingOperationAuthorised": false,
    "paymentActivationAuthorised": false,
    "emailAuthorised": false,
    "deploymentAuthorised": false,
    "publicBookingAuthorised": false
  },
  "trustedPullRequestValidation": {
    "implementationStatus": "AUTHORISED_BASELINE",
    "pullRequestTargetRequired": true,
    "protectedBaseCodeOnly": true,
    "protectedBaseBranch": "main",
    "sameRepositoryPullRequestsOnly": true,
    "headCheckoutOrExecutionProhibited": true,
    "headGitObjectsReadOnlyViaGitHubApi": true,
    "externalActionsPinnedToFullCommitSha": true,
    "maxChangedFiles": 32,
    "maxFileBytes": 65536,
    "maxTotalBytes": 262144,
    "protectedPaths": [
      ".github/workflows/bury-p1-trusted-pr-validation.yml",
      ".github/workflows/bury-p1-activation-probe.yml",
      "docs/bury-p1-required-workflow-ruleset.md",
      "policy/bury-p1-public-content-policy-v1.json",
      "scripts/validate-bury-p1-pull-request.mjs",
      "scripts/build-bury-p1-required-workflow-ruleset.mjs",
      "scripts/verify-bury-p1-required-workflow-ruleset.mjs",
      "scripts/validate-bury-p1-release-bundle.mjs",
      "scripts/consume-bury-p1-release.mjs",
      "scripts/run-bury-p1-activation-probe.mjs",
      "scripts/lib/bury-p1-trusted-pr-validator.mjs",
      "scripts/lib/bury-p1-release-runtime.mjs",
      "test/bury-p1-trusted-pr-validator.test.mjs",
      "test/bury-p1-release-runtime.test.mjs"
    ],
    "allowedPathPatterns": [
      "^README\\.md$",
      "^SECURITY\\.md$",
      "^schemas/bury-p1-[a-z0-9-]+-v2\\.schema\\.json$",
      "^manifests/bury-p1-reviewed(?:-complete-bundle|-content-ledger|-candidate-tree)?\\.json$",
      "^authorizations/bury-p1-owner-authorization\\.(?:json|sha256)$",
      "^\\.github/workflows/bury-p1-(?:manifest-validation|native-attestation|one-use-consumption)\\.yml$"
    ],
    "reservedWorkflowPaths": [
      ".github/workflows/bury-p1-manifest-validation.yml",
      ".github/workflows/bury-p1-native-attestation.yml",
      ".github/workflows/bury-p1-one-use-consumption.yml"
    ],
    "workflowContractMode": "IMMUTABLE_PATH_SPECIFIC_CLOSED_CONSERVATIVE_YAML",
    "approvedWorkflowContracts": {
      ".github/workflows/bury-p1-manifest-validation.yml": {
        "allowedTriggers": ["workflow_dispatch"],
        "allowedActions": ["actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683"],
        "requiredActionCounts": {"actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683": 1},
        "allowedRunCommands": ["node scripts/validate-bury-p1-release-bundle.mjs"],
        "requiredRunCounts": {"node scripts/validate-bury-p1-release-bundle.mjs": 1},
        "exactActionInputs": {"actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683": {"repository": "AlexM999911/singingattitude-release-attestations", "ref": "${{ github.sha }}", "persist-credentials": "false"}},
        "exactEnvironmentEntries": {},
        "exactRunConditions": {},
        "allowedTopLevelKeys": ["name", "on", "permissions", "jobs"],
        "allowedJobKeys": ["name", "runs-on", "timeout-minutes", "permissions", "steps"],
        "allowedStepKeys": ["name", "uses", "with", "run"],
        "allowedWithKeys": ["repository", "ref", "persist-credentials"],
        "allowedPermissionEntries": ["contents:read"],
        "requiredEnvironment": false,
        "requiredJobKeys": ["name", "runs-on", "timeout-minutes", "permissions", "steps"],
        "requiredPermissionEntries": ["contents:read"]
      },
      ".github/workflows/bury-p1-native-attestation.yml": {
        "allowedTriggers": ["workflow_dispatch"],
        "allowedActions": [
          "actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683",
          "actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6"
        ],
        "requiredActionCounts": {
          "actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683": 1,
          "actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6": 1
        },
        "allowedRunCommands": ["node scripts/validate-bury-p1-release-bundle.mjs"],
        "requiredRunCounts": {"node scripts/validate-bury-p1-release-bundle.mjs": 1},
        "exactActionInputs": {
          "actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683": {"repository": "AlexM999911/singingattitude-release-attestations", "ref": "${{ github.sha }}", "persist-credentials": "false"},
          "actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6": {"subject-path": "manifests/bury-p1-reviewed.json", "push-to-registry": "false", "show-summary": "false"}
        },
        "exactEnvironmentEntries": {},
        "exactRunConditions": {},
        "allowedTopLevelKeys": ["name", "on", "permissions", "jobs"],
        "allowedJobKeys": ["name", "runs-on", "timeout-minutes", "environment", "permissions", "steps"],
        "allowedStepKeys": ["name", "uses", "with", "run"],
        "allowedWithKeys": ["repository", "ref", "persist-credentials", "subject-path", "push-to-registry", "show-summary"],
        "allowedPermissionEntries": ["contents:read", "id-token:write", "attestations:write"],
        "requiredEnvironment": true,
        "requiredJobKeys": ["name", "runs-on", "timeout-minutes", "environment", "permissions", "steps"],
        "requiredPermissionEntries": ["contents:read", "id-token:write", "attestations:write"]
      },
      ".github/workflows/bury-p1-one-use-consumption.yml": {
        "allowedTriggers": ["workflow_dispatch"],
        "allowedActions": [
          "actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683",
          "actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6"
        ],
        "requiredActionCounts": {
          "actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683": 1,
          "actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6": 1
        },
        "allowedRunCommands": [
          "node scripts/consume-bury-p1-release.mjs preflight",
          "node scripts/consume-bury-p1-release.mjs finalize"
        ],
        "requiredRunCounts": {
          "node scripts/consume-bury-p1-release.mjs preflight": 1,
          "node scripts/consume-bury-p1-release.mjs finalize": 1
        },
        "exactActionInputs": {
          "actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683": {"repository": "AlexM999911/singingattitude-release-attestations", "ref": "${{ github.sha }}", "persist-credentials": "false"},
          "actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6": {"subject-path": "claims/bury-p1-pending.json", "push-to-registry": "false", "show-summary": "false"}
        },
        "exactEnvironmentEntries": {"GH_TOKEN": "${{ github.token }}"},
        "exactRunConditions": {"node scripts/consume-bury-p1-release.mjs finalize": "always()"},
        "allowedTopLevelKeys": ["name", "on", "permissions", "jobs"],
        "allowedJobKeys": ["name", "runs-on", "timeout-minutes", "environment", "permissions", "env", "steps"],
        "allowedStepKeys": ["name", "uses", "with", "run", "if"],
        "allowedWithKeys": ["repository", "ref", "persist-credentials", "subject-path", "push-to-registry", "show-summary"],
        "allowedPermissionEntries": ["contents:read", "contents:write", "id-token:write", "attestations:write"],
        "requiredEnvironment": true,
        "requiredJobKeys": ["name", "runs-on", "timeout-minutes", "environment", "permissions", "env", "steps"],
        "requiredPermissionEntries": ["contents:write", "id-token:write", "attestations:write"]
      }
    },
    "jsonContractMode": "IMMUTABLE_PATH_SPECIFIC_CLOSED_JSON_SCHEMA",
    "approvedJsonContracts": {
      "schemas/bury-p1-attestation-manifest-v2.schema.json": {
        "schemaProfile": "attestation-manifest-v2",
        "schemaId": "https://github.com/AlexM999911/singingattitude-release-attestations/schemas/bury-p1-attestation-manifest-v2.schema.json",
        "requiredRootProperties": ["schemaVersion", "recordId", "trustModel", "repository", "authorization", "candidate", "target", "executionWindow", "migrations", "owner", "boundaries"],
        "requiredTrueCheckProperties": []
      },
      "schemas/bury-p1-owner-authorization-v2.schema.json": {
        "schemaProfile": "owner-authorization-v2",
        "schemaId": "https://github.com/AlexM999911/singingattitude-release-attestations/schemas/bury-p1-owner-authorization-v2.schema.json",
        "requiredRootProperties": ["schemaVersion", "ownerIdentity", "candidateCommit", "candidateTree", "manifestSha256", "migrationHashes", "executionWindow", "recoveryOwner", "rollbackAuthority", "oneUse", "g2Authorized", "productionBookingAuthorized"],
        "requiredTrueCheckProperties": []
      },
      "schemas/bury-p1-consumption-claim-v2.schema.json": {
        "schemaProfile": "consumption-claim-v2",
        "schemaId": "https://github.com/AlexM999911/singingattitude-release-attestations/schemas/bury-p1-consumption-claim-v2.schema.json",
        "requiredRootProperties": ["schemaVersion", "authorizationId", "repository", "claimTag", "manifestSha256", "attestationBundleSha256", "candidateCommit", "ownerAuthorizationSha256", "executionWindow", "workflowRun", "oneUse", "p1Authorized", "g2Authorized", "productionBookingAuthorized", "issuedAtUtc"],
        "requiredTrueCheckProperties": []
      },
      "schemas/bury-p1-verification-receipt-v2.schema.json": {
        "schemaProfile": "verification-receipt-v2",
        "schemaId": "https://github.com/AlexM999911/singingattitude-release-attestations/schemas/bury-p1-verification-receipt-v2.schema.json",
        "requiredRootProperties": ["schemaVersion", "recordId", "result", "verifiedAtUtc", "repository", "candidateCommit", "manifestSha256", "attestationBundleSha256", "ownerAuthorizationSha256", "claim", "finalizerWorkflowRun", "checks", "authorityGrants"],
        "requiredTrueCheckProperties": ["repositoryIdentity", "workflowIdentity", "candidateBinding", "manifestBinding", "contentLedgerBinding", "migrationLedgerBinding", "ownerAuthorization", "ownerIdentity", "executionWindow", "nativeAttestation", "oneUse", "g2Locked", "productionBookingLocked", "recoveryAuthority", "rollbackAuthority"]
      }
    },
    "requiredWorkflowEnforcement": {
      "mechanism": "repository ruleset workflows rule",
      "apiVersion": "2026-03-10",
      "workflowPath": ".github/workflows/bury-p1-trusted-pr-validation.yml",
      "workflowRef": "refs/heads/main",
      "repository": "AlexM999911/singingattitude-release-attestations",
      "repositoryId": 1331425769,
      "repositoryIdRequired": true,
      "exactMergedWorkflowShaRequired": true,
      "genericStatusContextProhibited": true,
      "implementationStatus": "BLOCKED_UNTIL_POST_MERGE_ACTIVE_RULESET_READBACK"
    },
    "immutableConsumptionTagEnforcement": {
      "targetPatterns": ["refs/tags/bury-p1-consumed/*", "refs/tags/bury-p1-receipted/*"],
      "updateProhibited": true,
      "deletionProhibited": true,
      "bypassActors": [],
      "implementationStatus": "BLOCKED_UNTIL_ACTIVE_RULESET_READBACK"
    },
    "consumptionTagCreationEnforcement": {
      "targetPatterns": ["refs/tags/bury-p1-consumed/*", "refs/tags/bury-p1-receipted/*"],
      "creationRestricted": true,
      "onlyBypassActor": {"actorId": 15368, "actorType": "Integration", "bypassMode": "always"},
      "securityDependency": "trusted validator prohibits every other contents-write workflow",
      "implementationStatus": "BLOCKED_UNTIL_ACTIVE_RULESET_AND_RULE_SUITE_READBACK"
    },
    "activationProbe": {
      "workflowPath": ".github/workflows/bury-p1-activation-probe.yml",
      "scriptPath": "scripts/run-bury-p1-activation-probe.mjs",
      "trigger": "workflow_dispatch-with-no-inputs",
      "protectedMainOnly": true,
      "protectedEnvironment": "bury-p1-attestation",
      "fixedRef": "refs/tags/bury-p1-consumed/ACTIVATION-PROBE-ACTIONS",
      "mutationSurface": ["create-annotated-tag-object", "create-fixed-ref", "attempt-fixed-ref-update", "attempt-fixed-ref-delete"],
      "ruleSuiteRetrieval": "external-administration-read-required"
    }
  },
  "futureNativeAttestationContract": {
    "scope": "native-attestation-and-consumption-workflows-only",
    "implementationStatus": "AUTHORISED_PROTECTED_RUNTIME_CONTRACT",
    "signing": "GitHub-native OIDC and Sigstore only",
    "customSigningKey": false,
    "repositorySecretRequired": false,
    "environmentSecretRequired": false,
    "nativeAttestationPermissions": {
      "contents": "read",
      "id-token": "write",
      "attestations": "write"
    },
    "oneUseConsumptionPermissions": {
      "contents": "write",
      "id-token": "write",
      "attestations": "write"
    },
    "externalActionsPinnedToFullCommitSha": true,
    "pullRequestTargetProhibited": true,
    "untrustedForkAttestationProhibited": true,
    "protectedMainOnly": true
  }
}
